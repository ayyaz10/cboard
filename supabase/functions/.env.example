# Supabase Edge Function secrets only. Never expose these through VITE_*.
CLOUDFLARE_ACCOUNT_ID=your_32_character_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token
# Optional conservative request-allowance settings (these are the defaults):
CLOUDFLARE_IMAGE_RESERVE_USD=0.01
CLOUDFLARE_MONTHLY_USER_CAP_USD=1

# Server-side only. Set with `supabase secrets set`; never prefix with VITE_.
ENABLE_BANKING_APP_ID=your-enable-banking-application-uuid
ENABLE_BANKING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----
ENABLE_BANKING_ENVIRONMENT=SANDBOX
ENABLE_BANKING_REDIRECT_URI=https://your-project.supabase.co/functions/v1/banking/callback
APP_ORIGIN=https://your-cboard-domain.example
APP_BASE_PATH=/cboard/
