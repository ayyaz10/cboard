VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Enable Banking values are read only by the Supabase Edge Function; never add VITE_ to them.
# Configure real values with `supabase secrets set` (see supabase/functions/.env.example).
ENABLE_BANKING_APP_ID=your-enable-banking-application-uuid
ENABLE_BANKING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----
ENABLE_BANKING_ENVIRONMENT=SANDBOX
ENABLE_BANKING_REDIRECT_URI=https://your-project.supabase.co/functions/v1/banking/callback
APP_ORIGIN=https://your-cboard-domain.example
APP_BASE_PATH=/cboard/
